# The Coordinators — reporting credentials TEMPLATE.
#
# Copy this file to `.env` and fill in the real keys. `.env` is gitignored and must
# NEVER be committed — this template is the only credentials file that belongs in git.
#
#   cp .env.example .env      # then paste the real keys in
#
# Load before running a report:  set -a; source .env; set +a
# Check what's configured:       bash .claude/skills/master/scripts/preflight.sh
#
# Each system needs BOTH its URL and its key. The URLs below are the real public
# deployment hosts (not secret). Every *_KEY value is a placeholder — replace it.

# --- Meta Ads (.claude/skills/meta-ads) ---
META_STATS_API_URL=https://meta-stats.vercel.app
META_STATS_API_KEY=REPLACE_ME

# --- Forms Platform (.claude/skills/forms-platform) ---
FORMS_REPORTING_BASE_URL=https://forms.coordinators.pro
FORMS_REPORTING_API_KEY=REPLACE_ME

# --- Candidate Inventory (.claude/skills/candidate-inventory) ---
# No trailing slash on this one (the skill requires it).
CANDIDATE_INVENTORY_API_URL=https://candidate-inventory.vercel.app
CANDIDATE_INVENTORY_API_KEY=REPLACE_ME

# --- Screening App / Assessments (.claude/skills/screening-assessments) ---
# Host serves /summary, /channels, /sourcers. NOT the video-interview app.
SCREENING_API_BASE_URL=https://screening.coordinators.pro
SCREENING_API_KEY=REPLACE_ME

# --- Video Interview (.claude/skills/video-interview) ---
# Host serves /stats, /calibration. Separate deployment from the app above.
SCREENING_APP_URL=https://interview.coordinators.pro
SCREENING_APP_API_KEY=REPLACE_ME

# --- HELM Ops / Signal (.claude/skills/helm-ops) ---
HELM_OPS_BASE_URL=https://ops-system-gamma.vercel.app
HELM_OPS_API_KEY=REPLACE_ME

# --- Airtable (the base HELM Ops / Signal reads from) ---
# Read-only Personal Access Token: scopes data.records:read + schema.bases:read.
# Create at https://airtable.com/create/tokens and grant it the "helm ops" base.
# Base id is discoverable via GET https://api.airtable.com/v0/meta/bases.
AIRTABLE_API_KEY=REPLACE_ME
AIRTABLE_BASE_ID=appi3l0FPeo2KoRRI

# --- Candidate Assessment (.claude/skills/candidate-assessment) ---
# Proctored job-simulation assessment app. Most PII-sensitive system in the stack;
# the reporting API exposes metrics only. See MEMORY.md before relying on its numbers.
ASSESSMENT_REPORTING_URL=https://assesment.coordinators.pro
ASSESSMENT_REPORTING_KEY=REPLACE_ME

# --- The web UI (Control Room) ---
# Only needed to run or deploy the web app. The terminal playbook ignores these.
#
# APP_PASSWORD gates the deployed site. Until it is set, nobody can sign in —
# the app fails closed rather than serving live business data to the internet.
# Use something long; it is the only thing between a URL and this company's numbers.
APP_PASSWORD=REPLACE_ME

# Optional. Signs the session cookie. Leave blank and it is derived from
# APP_PASSWORD, which means changing the password signs everyone out (fine).
# Set it explicitly to keep sessions alive across a password change.
SESSION_SECRET=

# Optional. Turns on the "Ask" console — plain-English questions answered by
# running the playbook server-side. Without it the Dashboard and Systems views
# still work and the Ask tab reports itself switched off.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash — the current stable flagship, and the
# right shape for this loop: a full report is a dozen-plus tool round trips and
# Vercel functions have a wall-clock ceiling. gemini-3.5-flash also works.
# Whatever you set must support function calling.
GEMINI_MODEL=

# IMPORTANT: every key above grants read access to live business data. Treat a real
# `.env` like a password file. If one leaks, rotate it at the source system.
